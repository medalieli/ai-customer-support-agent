{
  "title": "NovaCart operations",
  "uid": "novacart-operations",
  "schemaVersion": 41,
  "refresh": "15s",
  "panels": [
    {"type":"timeseries","title":"Request rate","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum(rate(novacart_http_requests_total[5m]))"}],"gridPos":{"x":0,"y":0,"w":12,"h":8}},
    {"type":"timeseries","title":"P95 latency","datasource":{"uid":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(novacart_http_request_duration_seconds_bucket[5m])))"}],"gridPos":{"x":12,"y":0,"w":12,"h":8}},
    {"type":"bargauge","title":"Agent outcomes","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum by (outcome) (novacart_agent_outcomes_total)"}],"gridPos":{"x":0,"y":8,"w":8,"h":8}},
    {"type":"bargauge","title":"Provider health","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum by (provider, outcome) (novacart_provider_requests_total)"}],"gridPos":{"x":8,"y":8,"w":8,"h":8}},
    {"type":"stat","title":"Estimated OpenAI cost (USD)","datasource":{"uid":"prometheus"},"targets":[{"expr":"sum(novacart_openai_estimated_cost_usd_total)"}],"gridPos":{"x":16,"y":8,"w":8,"h":8}}
  ]
}
