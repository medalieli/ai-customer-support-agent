# Copy to .env for Docker Compose or local development. Values are synthetic/dev-only.
NOVACART_APP_ENV=development
NOVACART_LOG_LEVEL=INFO
NOVACART_API_URL=http://localhost:8000
NOVACART_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

POSTGRES_DB=novacart
POSTGRES_USER=novacart
POSTGRES_PASSWORD=replace-with-a-strong-local-password
NOVACART_POSTGRES_HOST=postgres
NOVACART_POSTGRES_PORT=5432
NOVACART_POSTGRES_DB=novacart
NOVACART_POSTGRES_USER=novacart
NOVACART_POSTGRES_PASSWORD=replace-with-a-strong-local-password
NOVACART_POSTGRES_CONNECT_TIMEOUT_SECONDS=3

NOVACART_REDIS_HOST=redis
NOVACART_REDIS_PORT=6379
NOVACART_REDIS_DB=0
NOVACART_REDIS_PASSWORD=
NOVACART_REDIS_CONNECT_TIMEOUT_SECONDS=3

COMMERCE_PROVIDER=mock
CRM_PROVIDER=mock

# Optional and unused in M1. Leave empty while the corresponding provider is disabled.
NOVACART_OPENAI_API_KEY=
NOVACART_SHOPIFY_STORE_DOMAIN=
NOVACART_SHOPIFY_ACCESS_TOKEN=
NOVACART_HUBSPOT_ACCESS_TOKEN=
