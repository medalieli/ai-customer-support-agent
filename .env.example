# Copy to .env for Docker Compose or local development. Values are synthetic/dev-only.
NOVACART_APP_ENV=development
NOVACART_LOG_LEVEL=INFO
NOVACART_API_URL=http://localhost:8000
NOVACART_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

POSTGRES_DB=novacart
POSTGRES_USER=novacart
POSTGRES_PASSWORD=replace-with-a-strong-local-password
NOVACART_POSTGRES_HOST=postgres
NOVACART_POSTGRES_PORT=5432
NOVACART_POSTGRES_DB=novacart
NOVACART_POSTGRES_USER=novacart
NOVACART_POSTGRES_PASSWORD=replace-with-a-strong-local-password
NOVACART_POSTGRES_CONNECT_TIMEOUT_SECONDS=3

NOVACART_REDIS_HOST=redis
NOVACART_REDIS_PORT=6379
NOVACART_REDIS_DB=0
NOVACART_REDIS_PASSWORD=
NOVACART_REDIS_CONNECT_TIMEOUT_SECONDS=3

NOVACART_DEMO_AUTH_ENABLED=true
NOVACART_DEMO_STAFF_PASSWORD=replace-with-a-demo-only-password
NOVACART_SESSION_TTL_SECONDS=3600
NOVACART_SESSION_COOKIE_NAME=novacart_session
NOVACART_SESSION_COOKIE_SECURE=false
NOVACART_SESSION_COOKIE_SAMESITE=lax
NOVACART_EMBEDDING_PROVIDER=openai
NOVACART_EMBEDDING_MODEL=text-embedding-3-small
NOVACART_EMBEDDING_DIMENSIONS=1536
NOVACART_EMBEDDING_BATCH_SIZE=64
NOVACART_EMBEDDING_TIMEOUT_SECONDS=20
NOVACART_EMBEDDING_MAX_RETRIES=2
NOVACART_RERANKER_PROVIDER=cross_encoder
NOVACART_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
NOVACART_RERANKER_MODEL_CACHE=/models
NOVACART_RETRIEVAL_LEXICAL_K=20
NOVACART_RETRIEVAL_VECTOR_K=20
NOVACART_RETRIEVAL_TOP_K=5
NOVACART_RETRIEVAL_MIN_RERANKER_SCORE=-3.07
NOVACART_CHUNK_SIZE_WORDS=120
NOVACART_CHUNK_OVERLAP_WORDS=20

MOCK_COMMERCE_APP_ENV=development
MOCK_COMMERCE_DATABASE_PATH=/data/commerce.db
MOCK_COMMERCE_INTERNAL_API_KEY=replace-with-a-long-internal-only-key
MOCK_COMMERCE_FAILURE_SIMULATION_ENABLED=true
MOCK_COMMERCE_SIMULATED_TIMEOUT_SECONDS=0.05
MOCK_COMMERCE_WEBHOOK_TARGET_URL=http://api:8000/api/v1/webhooks/mock_commerce/novacart-commerce
MOCK_COMMERCE_WEBHOOK_SECRET=mock-commerce-webhook-secret-32bytes

MOCK_CRM_APP_ENV=development
MOCK_CRM_DATABASE_PATH=/data/crm.db
MOCK_CRM_INTERNAL_API_KEY=replace-with-a-long-internal-only-key
MOCK_CRM_FAILURE_SIMULATION_ENABLED=true
MOCK_CRM_SIMULATED_TIMEOUT_SECONDS=0.05
MOCK_CRM_WEBHOOK_TARGET_URL=http://api:8000/api/v1/webhooks/mock_crm/novacart-crm
MOCK_CRM_WEBHOOK_SECRET=mock-crm-webhook-secret-at-least-32

COMMERCE_PROVIDER=mock
CRM_PROVIDER=mock
NOVACART_PROVIDER_READ_TIMEOUT_SECONDS=5
NOVACART_PROVIDER_WRITE_TIMEOUT_SECONDS=10
NOVACART_PROVIDER_MAX_RETRIES=2
NOVACART_MOCK_COMMERCE_URL=http://mock-commerce:8080
NOVACART_MOCK_COMMERCE_INTERNAL_API_KEY=replace-with-a-long-internal-only-key
NOVACART_MOCK_CRM_URL=http://mock-crm:8090
NOVACART_MOCK_CRM_INTERNAL_API_KEY=replace-with-a-long-internal-only-key
NOVACART_SHOPIFY_API_VERSION=2026-01

# Required for the real M4 demo embedding provider. Automated tests override the provider to fake.
NOVACART_OPENAI_API_KEY=replace-with-an-openai-project-api-key
NOVACART_AGENT_MODEL=gpt-5-mini
NOVACART_AGENT_MODEL_TIMEOUT_SECONDS=15
NOVACART_AGENT_MAX_STEPS=8
NOVACART_AGENT_MIN_CONFIDENCE=0.65
NOVACART_ACTION_SECRET=replace-with-at-least-32-random-bytes
NOVACART_ACTION_CONFIRMATION_TTL_SECONDS=600
NOVACART_WEBHOOK_REPLAY_WINDOW_SECONDS=300
NOVACART_WEBHOOK_MAX_BODY_BYTES=262144
NOVACART_WEBHOOK_MAX_ATTEMPTS=5
NOVACART_WEBHOOK_RETRY_BASE_SECONDS=5
NOVACART_MOCK_COMMERCE_WEBHOOK_SECRET=mock-commerce-webhook-secret-32bytes
NOVACART_MOCK_CRM_WEBHOOK_SECRET=mock-crm-webhook-secret-at-least-32
NOVACART_SHOPIFY_STORE_DOMAIN=
NOVACART_SHOPIFY_ACCESS_TOKEN=
NOVACART_HUBSPOT_ACCESS_TOKEN=
