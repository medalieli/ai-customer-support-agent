# Production-like template: placeholders only. Copy to .env.production and provision ./secrets.
NOVACART_APP_ENV=production
NOVACART_LOG_LEVEL=INFO
NOVACART_API_URL=https://localhost:8443
NOVACART_FRONTEND_URL=https://localhost:8443
NEXT_PUBLIC_API_URL=https://localhost:8443
NOVACART_DOCS_ENABLED=false
NOVACART_METRICS_ENABLED=true
NOVACART_TRUST_PROXY_HEADERS=true
NOVACART_DEMO_AUTH_ENABLED=false
NOVACART_SESSION_COOKIE_SECURE=true
NOVACART_SESSION_COOKIE_SAMESITE=strict
NOVACART_CSRF_PROTECTION_ENABLED=true
POSTGRES_DB=novacart
POSTGRES_USER=novacart_migrator
POSTGRES_PASSWORD=read-from-docker-secret
NOVACART_RUNTIME_DB_USER=novacart_runtime
NOVACART_POSTGRES_HOST=postgres
NOVACART_POSTGRES_DB=novacart
NOVACART_POSTGRES_PASSWORD=read-from-docker-secret
NOVACART_REDIS_HOST=redis
NOVACART_REDIS_PASSWORD=read-from-docker-secret
COMMERCE_PROVIDER=mock
CRM_PROVIDER=mock
NOVACART_MOCK_COMMERCE_URL=http://mock-commerce:8080
NOVACART_MOCK_COMMERCE_INTERNAL_API_KEY=replace-with-32-random-characters
NOVACART_MOCK_CRM_URL=http://mock-crm:8090
NOVACART_MOCK_CRM_INTERNAL_API_KEY=replace-with-32-random-characters
NOVACART_EMBEDDING_PROVIDER=openai
NOVACART_RERANKER_PROVIDER=cross_encoder
NOVACART_AGENT_PROVIDER=openai
NOVACART_OPENAI_API_KEY=inject-at-runtime
NOVACART_ACTION_SECRET=replace-with-32-random-characters
NOVACART_MOCK_COMMERCE_WEBHOOK_SECRET=replace-with-32-random-characters
NOVACART_MOCK_CRM_WEBHOOK_SECRET=replace-with-32-random-characters
MOCK_COMMERCE_APP_ENV=production
MOCK_COMMERCE_INTERNAL_API_KEY=replace-with-32-random-characters
MOCK_COMMERCE_FAILURE_SIMULATION_ENABLED=false
MOCK_CRM_APP_ENV=production
MOCK_CRM_INTERNAL_API_KEY=replace-with-32-random-characters
MOCK_CRM_FAILURE_SIMULATION_ENABLED=false
